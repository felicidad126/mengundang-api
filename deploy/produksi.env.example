# Salin menjadi deploy/produksi.env (mode 600) lalu isi. Berkas produksi.env tidak pernah masuk git.

# Image hasil CI, dengan digest, mis. ghcr.io/felicidad126/mengundang-api@sha256:...
MENGUNDANG_IMAGE=

# Dua kata sandi database, heksadesimal agar aman di dalam URL:  openssl rand -hex 32
# Pemilik skema (migrasi, admin, backup) dan peran aplikasi (API). Peran aplikasi dibuat
# hanya saat database pertama kali dibuat; mengganti nilainya kemudian: lihat docs/operasi.md.
MENGUNDANG_DB_PASSWORD=
MENGUNDANG_APP_DB_PASSWORD=

# Origin situs undangan yang boleh mengirim RSVP dan ucapan dari browser (pisahkan dengan koma).
MENGUNDANG_ASAL=https://invitation.helonoia.com

# Port API di 127.0.0.1 (nginx meneruskan /api/ ke sini).
MENGUNDANG_API_PORT=8090

# RSVP dan ucapan dihapus otomatis sekian hari setelah tanggal acara.
MENGUNDANG_RETENSI_HARI=90

# Batas tulis per acara per jam, menahan banjir spam yang berganti IP dan isi (selain batas
# per IP di nginx). Bawaannya longgar: undangan yang disebar ke ratusan tamu sekaligus tidak
# tertolak. RSVP yang diperbarui dari perangkat yang sama tidak dihitung.
MENGUNDANG_BATAS_UCAPAN_PER_JAM=300
MENGUNDANG_BATAS_RSVP_BARU_PER_JAM=600

# Backup terenkripsi harian. Wajib: berkas kunci PUBLIK backup. Kunci privat TIDAK di server.
MENGUNDANG_BACKUP_PUBLIC_KEY=./kunci/backup-public.asc
MENGUNDANG_BACKUP_DIR=./backup
# Jam backup harian dalam UTC (18:30 UTC = 01:30 WIB) dan lama simpan di server (hari).
MENGUNDANG_BACKUP_TIME_UTC=18:30
MENGUNDANG_BACKUP_RETENTION_DAYS=30
# GID grup tarik-backup di host, diisi oleh deploy/salin-backup/pasang-akun-tarik.sh.
MENGUNDANG_BACKUP_FILE_GROUP=
